{
  "manifest_version": 3,
  "name": "Screen Pet",
  "version": "1.5.0",
  "description": "A little browser companion: cat, brown dog, white dog, hamster, dino or harp seal. Soft and pixel styles, birthdays and daily tarot.",
  "permissions": ["storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pick a pet",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["pets.js", "pets-pixel.js", "birthday.js", "language.js", "fortune.js", "fortune-ui.js", "content.js"],
      "css": ["styles.css", "fortune.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
